{
  "name": "noteflow",
  "displayName": "Noteflow — Synced Markdown Notes",
  "description": "Keep a folder of Markdown notes in the side bar, synced between every VS Code you sign in to with Settings Sync.",
  "version": "2.0.0",
  "publisher": "JamacioRocha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamacio/noteflow.git"
  },
  "bugs": {
    "url": "https://github.com/jamacio/noteflow/issues"
  },
  "homepage": "https://github.com/jamacio/noteflow#readme",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "notes",
    "note taking",
    "markdown",
    "sync",
    "settings sync",
    "sidebar",
    "notebook",
    "journal",
    "todo",
    "memo",
    "wiki",
    "knowledge base"
  ],
  "pricing": "Free",
  "qna": "https://github.com/jamacio/noteflow/issues",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noteflow",
          "title": "Noteflow",
          "icon": "resources/noteflow.svg"
        }
      ]
    },
    "views": {
      "noteflow": [
        {
          "id": "noteflow.myNotes",
          "name": "My Notes"
        },
        {
          "id": "noteflow.projectNotes",
          "name": "Project Notes",
          "when": "noteflow.hasProjectNotes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "noteflow.myNotes",
        "contents": "No notes folder is set yet.\n[Choose Notes Folder](command:noteflow.chooseFolder)",
        "when": "noteflow.myNotesState == unset"
      },
      {
        "view": "noteflow.myNotes",
        "contents": "The notes folder doesn't exist.\n[Create Folder](command:noteflow.createFolder)\n[Choose Notes Folder](command:noteflow.chooseFolder)",
        "when": "noteflow.myNotesState == missing"
      },
      {
        "view": "noteflow.myNotes",
        "contents": "No notes yet.\n[New Note](command:noteflow.newNote)\n[New Folder](command:noteflow.newFolder)",
        "when": "noteflow.myNotesState == empty"
      },
      {
        "view": "noteflow.projectNotes",
        "contents": "No notes yet.\n[New Note](command:noteflow.newNote)\n[New Folder](command:noteflow.newFolder)",
        "when": "noteflow.projectNotesState == empty"
      }
    ],
    "commands": [
      {
        "command": "noteflow.newNote",
        "title": "New Note",
        "category": "Noteflow",
        "icon": "$(new-file)"
      },
      {
        "command": "noteflow.newFolder",
        "title": "New Folder",
        "category": "Noteflow",
        "icon": "$(new-folder)"
      },
      {
        "command": "noteflow.quickOpen",
        "title": "Quick Open Notes",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.rename",
        "title": "Rename",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.delete",
        "title": "Delete",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.moveTo",
        "title": "Move To...",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.search",
        "title": "Search Notes",
        "category": "Noteflow",
        "icon": "$(search)"
      },
      {
        "command": "noteflow.sortBy",
        "title": "Sort By...",
        "category": "Noteflow",
        "icon": "$(list-ordered)"
      },
      {
        "command": "noteflow.refresh",
        "title": "Refresh",
        "category": "Noteflow",
        "icon": "$(refresh)"
      },
      {
        "command": "noteflow.openPreview",
        "title": "Open Preview",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.chooseFolder",
        "title": "Choose Notes Folder",
        "category": "Noteflow",
        "icon": "$(folder-opened)"
      },
      {
        "command": "noteflow.createFolder",
        "title": "Create Folder",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.setupProjectNotes",
        "title": "Set Up Project Notes",
        "category": "Noteflow"
      },
      {
        "command": "noteflow.syncNow",
        "title": "Sync Now",
        "category": "Noteflow",
        "icon": "$(sync)"
      },
      {
        "command": "noteflow.clearRecent",
        "title": "Clear Recent Notes",
        "category": "Noteflow"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "noteflow.rename",
          "when": "false"
        },
        {
          "command": "noteflow.delete",
          "when": "false"
        },
        {
          "command": "noteflow.moveTo",
          "when": "false"
        },
        {
          "command": "noteflow.openPreview",
          "when": "false"
        },
        {
          "command": "noteflow.revealInOS",
          "when": "false"
        },
        {
          "command": "noteflow.createFolder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "noteflow.newNote",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "navigation@1"
        },
        {
          "command": "noteflow.newFolder",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "navigation@2"
        },
        {
          "command": "noteflow.search",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "navigation@3"
        },
        {
          "command": "noteflow.sortBy",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "navigation@4"
        },
        {
          "command": "noteflow.syncNow",
          "when": "view == noteflow.myNotes",
          "group": "navigation@5"
        },
        {
          "command": "noteflow.refresh",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "1_refresh"
        },
        {
          "command": "noteflow.revealInOS",
          "when": "view == noteflow.myNotes || view == noteflow.projectNotes",
          "group": "1_refresh"
        },
        {
          "command": "noteflow.chooseFolder",
          "when": "view == noteflow.myNotes",
          "group": "1_refresh"
        }
      ],
      "view/item/context": [
        {
          "command": "noteflow.openPreview",
          "when": "view =~ /^noteflow\\./ && viewItem == note-md",
          "group": "inline"
        },
        {
          "command": "noteflow.newNote",
          "when": "view =~ /^noteflow\\./ && viewItem == folder",
          "group": "1_new@1"
        },
        {
          "command": "noteflow.newFolder",
          "when": "view =~ /^noteflow\\./ && viewItem == folder",
          "group": "1_new@2"
        },
        {
          "command": "noteflow.rename",
          "when": "view =~ /^noteflow\\./ && (viewItem == folder || viewItem =~ /^note/)",
          "group": "2_modify@1"
        },
        {
          "command": "noteflow.delete",
          "when": "view =~ /^noteflow\\./ && (viewItem == folder || viewItem =~ /^note/)",
          "group": "2_modify@2"
        },
        {
          "command": "noteflow.moveTo",
          "when": "view =~ /^noteflow\\./ && (viewItem == folder || viewItem =~ /^note/)",
          "group": "2_modify@3"
        },
        {
          "command": "noteflow.search",
          "when": "view =~ /^noteflow\\./ && viewItem == folder",
          "group": "3_search"
        },
        {
          "command": "noteflow.revealInOS",
          "when": "view =~ /^noteflow\\./ && (viewItem == folder || viewItem =~ /^note/)",
          "group": "4_reveal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "noteflow.newNote",
        "key": "alt+n"
      },
      {
        "command": "noteflow.quickOpen",
        "key": "alt+l"
      }
    ],
    "configuration": {
      "title": "Noteflow",
      "properties": {
        "noteflow.folder": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Folder used for My Notes. '~' expands to your home folder."
        },
        "noteflow.projectFolder": {
          "type": "string",
          "default": ".notes",
          "description": "Folder used for Project Notes, relative to the first workspace folder (an absolute path also works)."
        },
        "noteflow.defaultExtension": {
          "type": "string",
          "default": "md",
          "description": "Extension given to a new note when the typed name has none."
        },
        "noteflow.newNoteName": {
          "type": "string",
          "default": "",
          "description": "Name pre-filled when creating a note. Tokens: {yyyy} {mm} {dd} {HH} {MM}. Empty leaves the input empty."
        },
        "noteflow.fileTypes": {
          "type": "string",
          "default": "*",
          "description": "Comma-separated extensions shown and synced, or '*' for all."
        },
        "noteflow.sort": {
          "type": "string",
          "enum": [
            "name",
            "name-desc",
            "modified",
            "created"
          ],
          "default": "name",
          "description": "Order of notes in both views and in Quick Open."
        },
        "noteflow.sync": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Sync My Notes through Settings Sync."
        },
        "noteflow.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "description": "Polling interval for outside changes while a view is visible."
        }
      }
    }
  },
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production && npx -y @vscode/vsce package",
    "test": "mocha",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "mocha": "^10.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
